---
// Licences and accreditations. Only entries ticked "Show on the website" in the CMS appear.
// compact: Home page (licences + ISO only, link to the full list). Full: About page, grouped.
import { t, type Lang } from '../i18n/strings';
import { credentials, type Credential } from '../data/projects';
interface Props { lang: Lang; compact?: boolean }
const { lang, compact = false } = Astro.props;
const s = t(lang).credentials;
const groups = ['licence', 'iso', 'sustainability', 'compliance'] as const;
const shown = compact ? credentials.filter((c) => c.group === 'licence' || c.group === 'iso') : credentials;
const fmtDate = (d: string) => new Date(d + 'T00:00:00').toLocaleDateString(lang === 'ar' ? 'ar-SA-u-ca-gregory-nu-latn' : 'en-GB', { year: 'numeric', month: 'long' });
const rows = (list: Credential[]) => list;
---
{shown.length > 0 && (
  <section class="section creds" id="credentials" aria-labelledby={compact ? 'creds-title' : 'creds-title-full'}>
    <div class="wrap two-col">
      <div class="intro">
        <h2 id={compact ? 'creds-title' : 'creds-title-full'}>{s.title}</h2>
        <p class="lede">{s.lede}</p>
        {compact && credentials.length > shown.length && <a class="link-line more" href={`/${lang}/about/#credentials`}>{s.all}</a>}
      </div>
      <div class="groups">
        {groups.map((g) => {
          const list = rows(shown.filter((c) => c.group === g));
          return list.length > 0 && (
            <div class="group">
              {!compact && <h3 class="group-title">{s.groups[g]}</h3>}
              <ul class="list">
                {list.map((c) => (
                  <li class="item">
                    <div class="head">
                      <span class="title">{c.title[lang]}</span>
                      {c.value[lang] && <span class="value">{c.value[lang]}</span>}
                    </div>
                    {(c.issuer[lang] || c.reference || c.validUntil) && (
                      <p class="meta">
                        {c.issuer[lang] && <span>{c.issuer[lang]}</span>}
                        {c.reference && <span>{s.ref} <bdi dir="ltr">{c.reference}</bdi></span>}
                        {c.validUntil && <span>{s.validUntil} {fmtDate(c.validUntil)}</span>}
                      </p>
                    )}
                    {c.document && <a class="link-line doc" href={c.document} target="_blank" rel="noopener">{s.view}</a>}
                  </li>
                ))}
              </ul>
            </div>
          );
        })}
      </div>
    </div>
  </section>
)}

<style>
  .intro { display: grid; gap: var(--sp-2); align-content: start; justify-items: start; }
  .lede { color: var(--ink-2); max-inline-size: 34ch; }
  .more { color: var(--ink-2); font-size: var(--step--1); margin-block-start: var(--sp-1); }
  :global(html[lang='ar']) .more { font-size: var(--step-0); }
  .groups { display: grid; gap: var(--sp-5); }
  .group-title { font-size: var(--step--1); font-weight: 500; color: var(--ink-3); margin-block-end: var(--sp-2); }
  :global(html[lang='ar']) .group-title { font-size: var(--step-0); }
  .list { list-style: none; margin: 0; padding: 0; border-block-start: 1px solid var(--line); }
  .item { padding-block: var(--sp-3); border-block-end: 1px solid var(--line); display: grid; gap: var(--sp-1); }
  .head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--sp-1) var(--sp-3); }
  .title { font-size: var(--step-1); font-weight: 500; }
  .value { font-size: var(--step-1); font-weight: 500; color: var(--red-ink); white-space: nowrap; }
  .meta { display: flex; flex-wrap: wrap; gap: 0 var(--sp-3); color: var(--ink-3); font-size: var(--step--1); }
  :global(html[lang='ar']) .meta { font-size: 0.95rem; }
  .doc { justify-self: start; font-size: var(--step--1); color: var(--ink-2); }
  :global(html[lang='ar']) .doc { font-size: 0.95rem; }
</style>
