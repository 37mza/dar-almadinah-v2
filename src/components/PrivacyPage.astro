---
import { t, type Lang } from '../i18n/strings';
interface Props { lang: Lang }
const { lang } = Astro.props;
const p = t(lang).privacy;
---
<article class="wrap doc">
  <header class="doc-head">
    <h1 class="page-title">{p.title}</h1>
    <p class="updated">{p.updated}</p>
    <p class="intro">{p.intro}</p>
  </header>
  {p.sections.map((sec) => (
    <section class="doc-sec">
      <h2>{sec.h}</h2>
      <p>{sec.p}</p>
    </section>
  ))}
</article>

<style>
  .doc { padding-block: calc(var(--header-h) + var(--sp-6)) var(--section); max-inline-size: calc(68ch + var(--gutter) * 2); }
  .doc-head { display: grid; gap: var(--sp-2); margin-block-end: var(--sp-5); }
  .page-title { font-size: var(--step-3); letter-spacing: var(--track-display); line-height: var(--lead-display); }
  :global(html[lang='ar']) .page-title { font-weight: 600; }
  .updated { color: var(--ink-3); font-size: var(--step--1); letter-spacing: var(--track-small); }
  .intro { font-size: var(--step-1); color: var(--ink-2); line-height: 1.7; }
  .doc-sec { padding-block: var(--sp-4); border-block-start: 1px solid var(--line); display: grid; gap: var(--sp-1); }
  .doc-sec h2 { font-size: var(--step-1); letter-spacing: var(--track-title); line-height: var(--lead-title); }
  .doc-sec p { color: var(--ink-2); line-height: 1.75; }
</style>
