---
import { t, type Lang } from '../i18n/strings';
import { projects } from '../data/projects';
import ProjectCard from './ProjectCard.astro';
import ProjectOverlay from './ProjectOverlay.astro';
import InquiryForm from './InquiryForm.astro';
import Figures from './Figures.astro';
import Credentials from './Credentials.astro';
import Partners from './Partners.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const featured = projects.filter((p) => p.featured).slice(0, 4);
// Hero image: the first featured project's cover (change it by reordering projects in the CMS)
const heroImg = (featured[0] ?? projects[0])?.images[0];
---
<!-- HERO: one render, one heading, one sentence, two actions. No entrance or scroll effects. -->
<section class="hero" aria-labelledby="hero-title">
  <div class="hero-media" aria-hidden="true">
    {heroImg && <img src={heroImg} alt="" fetchpriority="high" width="2000" height="1375" />}
  </div>
  <div class="wrap hero-content">
    <h1 class="hero-title" id="hero-title">{s.hero.title}</h1>
    <p class="hero-lede">{s.hero.lede}</p>
    <div class="hero-ctas">
      <button type="button" class="btn" data-inquire>{s.hero.cta}</button>
      <a href={`/${lang}/projects/`} class="btn btn--ghost">{s.hero.secondary}</a>
    </div>
  </div>
</section>

<Figures lang={lang} />

<!-- SELECTED PROJECTS -->
<section class="section featured" aria-labelledby="featured-title">
  <div class="wrap">
    <div class="sec-head">
      <h2 id="featured-title">{s.featured.title}</h2>
      <a href={`/${lang}/projects/`} class="link-line all">{s.featured.all}</a>
    </div>
    <div class="feat-grid">
      {featured.map((p, i) => (
        <div class:list={['slot', { wide: i === 0 }]}>
          <ProjectCard lang={lang} project={p} i={i} size={i === 0 ? 'lg' : 'md'} eager={i === 0} />
        </div>
      ))}
    </div>
  </div>
</section>

<Credentials lang={lang} compact />

<Partners lang={lang} />

<!-- INQUIRY -->
<section class="section inquiry" id="inquire" aria-labelledby="inq-title">
  <div class="wrap two-col">
    <div class="inq-intro">
      <h2 id="inq-title">{s.inquiry.title}</h2>
      <p class="inq-lede">{s.inquiry.lede}</p>
    </div>
    <InquiryForm lang={lang} id="section" />
  </div>
</section>

<ProjectOverlay lang={lang} />

<script>
  import '../scripts/projects';
</script>

<style>
  /* ================= HERO ================= */
  .hero {
    position: relative;
    margin-block-start: var(--header-h);
    min-block-size: min(calc(100svh - var(--header-h)), 820px);
    display: grid; align-items: end;
    overflow: clip;
    isolation: isolate;
  }
  .hero-media { position: absolute; inset: 0; z-index: -2; }
  .hero-media img { inline-size: 100%; block-size: 100%; object-fit: cover; }
  /* A plain scrim so the text stays readable on any render; it fades toward the page color. */
  .hero::before {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(to top, var(--bg) 0%, rgb(var(--bg-rgb) / var(--hero-scrim)) 35%, rgb(var(--bg-rgb) / 0) 75%);
  }
  .hero-content {
    padding-block: var(--sp-7) var(--sp-6);
    display: grid; gap: var(--sp-3); justify-items: start;
  }
  .hero-title { font-size: var(--step-4); letter-spacing: var(--track-display); line-height: var(--lead-display); font-weight: 500; max-inline-size: 20ch; }
  :global(html[lang='ar']) .hero-title { font-weight: 600; max-inline-size: 18ch; }
  .hero-lede { max-inline-size: 52ch; color: var(--ink-2); font-size: var(--step-1); line-height: 1.6; }
  .hero-ctas { display: flex; flex-wrap: wrap; gap: var(--sp-2); margin-block-start: var(--sp-1); }


  /* ================= SELECTED PROJECTS ================= */
  .sec-head { display: flex; justify-content: space-between; align-items: baseline; gap: var(--sp-2); margin-block-end: var(--sp-5); }
  .all { color: var(--ink-2); font-size: var(--step--1); letter-spacing: var(--track-small); line-height: var(--lead-small); }
  :global(html[lang='ar']) .all { font-size: var(--step-0); }
  .feat-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--sp-5) var(--sp-3); }
  .slot.wide { grid-column: 1 / -1; }
  @media (max-width: 960px) { .feat-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .feat-grid { grid-template-columns: 1fr; } }

  /* ================= INQUIRY ================= */
  .inquiry { background: var(--bg-raised); }
  .inq-intro { display: grid; gap: var(--sp-2); align-content: start; }
  .inq-lede { color: var(--ink-2); max-inline-size: 36ch; }
</style>
