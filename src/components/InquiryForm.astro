---
import { t, contact, type Lang } from '../i18n/strings';
interface Props { lang: Lang; id: string; compact?: boolean }
const { lang, id, compact = false } = Astro.props;
const s = t(lang).inquiry;
const key = import.meta.env.PUBLIC_WEB3FORMS_KEY as string | undefined;
---
<form
  class:list={['inq', { compact }]}
  data-inquiry-form
  data-endpoint={key ? 'https://api.web3forms.com/submit' : ''}
  data-mailto={contact.email}
  data-msg-sending={s.sending}
  data-msg-sent={s.sent}
  data-msg-error={s.error}
  data-msg-wait={lang === 'ar' ? 'تم إرسال طلبك للتو. انتظر قليلًا قبل إرسال طلب آخر.' : 'Your request was just sent. Please wait a moment before sending another.'}
  novalidate
>
  {key && <input type="hidden" name="access_key" value={key} />}
  <input type="hidden" name="subject" value={lang === 'ar' ? 'طلب عرض جديد من موقع دار المدينة' : 'New proposal request from the Dar Al Madinah website'} />
  <input type="hidden" name="from_name" value="daralmadinah.com.sa" />
  <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <div class="grid">
    <label class="field">
      <span class="lbl">{s.name}</span>
      <input name="name" type="text" autocomplete="name" required minlength="2" maxlength="100" enterkeyhint="next" />
    </label>
    <label class="field">
      <span class="lbl">{s.company} <em>({s.optional})</em></span>
      <input name="company" type="text" autocomplete="organization" maxlength="120" enterkeyhint="next" />
    </label>
    <label class="field">
      <span class="lbl">{s.email}</span>
      <input name="email" type="email" autocomplete="email" autocapitalize="none" autocorrect="off" spellcheck="false" required maxlength="254" dir="ltr" enterkeyhint="next" />
    </label>
    <label class="field">
      <span class="lbl">{s.phone}</span>
      <input name="phone" type="tel" inputmode="tel" autocomplete="tel" required minlength="7" maxlength="20" pattern="\+?[0-9 \(\)\-]{7,20}" dir="ltr" placeholder="+966" enterkeyhint="next" />
    </label>
  </div>

  <fieldset class="types">
    <legend class="lbl">{s.type}</legend>
    <div class="chips">
      {s.types.map((ty, i) => (
        <label class="chip">
          <input type="radio" name="project_type" value={ty} checked={i === 0} />
          <span>{ty}</span>
        </label>
      ))}
    </div>
  </fieldset>

  <label class="field">
    <span class="lbl">{s.message}</span>
    <textarea name="message" rows={compact ? 4 : 5} placeholder={s.messageHint} maxlength="4000" enterkeyhint="send"></textarea>
  </label>

  <div class="actions">
    <button type="submit" class="btn submit" data-submit>
      <span class="label" data-label>{s.submit}</span>
    </button>
    <p class="status" role="status" aria-live="polite" data-status></p>
  </div>

  <div class="direct">
    <span class="lbl">{s.or}</span>
    <a href={`mailto:${contact.email}`} class="link-line" dir="ltr">{contact.email}</a>
    <a href={`tel:${contact.phoneTel}`} class="link-line" dir="ltr">{contact.phoneDisplay}</a>
    <a href={contact.whatsapp} class="wa" target="_blank" rel="noopener">
      <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2c-1.6 0-3.1-.4-4.4-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.4.1-.6.3-.2.2-.8.8-.8 2s.9 2.3 1 2.5c.1.2 1.7 2.6 4.1 3.6 1.5.7 2.1.7 2.9.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.1-1.2l-.4-.3Z"/></svg>
      {s.whatsapp}
    </a>
  </div>
</form>

<style>
  .inq { display: grid; gap: var(--sp-4); }
  .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--sp-3); }
  .compact .grid { grid-template-columns: 1fr; }
  @media (max-width: 640px) { .grid { grid-template-columns: 1fr; } }
  .field { display: grid; gap: var(--sp-1); }
  .lbl { font-size: var(--step--1); color: var(--ink-3); }
  :global(html[lang='ar']) .lbl { font-size: 0.95rem; }
  .lbl em { font-style: normal; opacity: 0.7; }
  input:not([type='radio']):not([type='checkbox']), textarea {
    inline-size: 100%;
    background: transparent;
    border: 0; border-block-end: 1px solid var(--line-strong);
    border-radius: 0;
    padding: 0.6rem 0;
    color: var(--ink);
    transition: border-color 200ms ease;
    outline: none;
  }
  textarea { resize: vertical; min-block-size: 7rem; }
  input::placeholder, textarea::placeholder { color: var(--ink-3); opacity: 0.7; }
  input:focus, textarea:focus { border-color: var(--red-ink); }
  input[dir='ltr'] { text-align: start; }
  :global(html[dir='rtl']) input[dir='ltr'] { text-align: end; }
  .field.is-invalid input, .field.is-invalid textarea { border-color: var(--red-ink); }

  .types { border: 0; padding: 0; margin: 0; display: grid; gap: var(--sp-2); }
  .chips { display: flex; flex-wrap: wrap; gap: var(--sp-1); }
  .chip { position: relative; cursor: pointer; }
  .chip input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .chip span {
    display: inline-flex; align-items: center; min-block-size: 2.5rem; padding-inline: 1rem;
    border-radius: 2px; box-shadow: inset 0 0 0 1px var(--line-strong);
    color: var(--ink-2); font-size: var(--step--1);
    transition: background-color 200ms ease, color 200ms ease, box-shadow 200ms ease, transform var(--dur-press) var(--ease-out);
  }
  :global(html[lang='ar']) .chip span { font-size: 0.95rem; }
  .chip:active span { transform: scale(0.97); }
  .chip input:checked + span { background: var(--ink); color: var(--bg); box-shadow: none; }
  .chip input:focus-visible + span { outline: 2px solid var(--red-ink); outline-offset: 2px; }
  @media (hover: hover) and (pointer: fine) {
    .chip:hover input:not(:checked) + span { box-shadow: inset 0 0 0 1px var(--ink-2); color: var(--ink); }
  }

  .actions { display: flex; align-items: center; flex-wrap: wrap; gap: var(--sp-2) var(--sp-3); }
  .submit { min-inline-size: 12rem; }
  .submit .label { transition: filter 200ms ease, opacity 200ms ease; }
  .submit.is-swapping .label { filter: blur(3px); opacity: 0; }
  .submit[aria-busy='true'] { pointer-events: none; }
  .status { color: var(--ink-2); font-size: var(--step--1); min-block-size: 1.2em; }
  :global(html[lang='ar']) .status { font-size: 0.95rem; }
  .status.ok { color: var(--ink); }
  .status.err { color: var(--red-ink); }

  .direct { display: flex; flex-wrap: wrap; align-items: center; gap: var(--sp-1) var(--sp-3); padding-block-start: var(--sp-3); border-block-start: 1px solid var(--line); font-size: var(--step--1); }
  :global(html[lang='ar']) .direct { font-size: 0.95rem; }
  .direct .lbl { inline-size: 100%; }
  .wa { display: inline-flex; align-items: center; gap: 0.45rem; color: var(--ink); padding: 0.45rem 0.85rem; border-radius: 2px; box-shadow: inset 0 0 0 1px var(--line-strong); transition: background-color 200ms ease, transform var(--dur-press) var(--ease-out); }
  .wa:active { transform: scale(0.97); }
  @media (hover: hover) and (pointer: fine) { .wa:hover { background: rgb(var(--ink-rgb) / 0.06); } }
  .hp { position: absolute; inset-inline-start: -9999px; }
</style>
