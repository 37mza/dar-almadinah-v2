---
import { t, type Lang } from '../i18n/strings';
import { projects, allProjects, mapProjects, type Category } from '../data/projects';
import ProjectsMap from './ProjectsMap.astro';
import { MAP_ENABLED } from '../config/site';
import ProjectCard from './ProjectCard.astro';
import ProjectOverlay from './ProjectOverlay.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang).projects;
const used = new Set(allProjects.map((p) => p.category));
const cats: ('all' | Category)[] = ['all', ...(['hospitality', 'residential', 'commercial', 'mixed'] as Category[]).filter((c) => used.has(c))];
---
<section class="pj-head">
  <div class="wrap">
    <h1 class="pj-title">{s.title}</h1>
    <p class="pj-lede">{s.lede}</p>
    <div class="pj-bar">
      <div class="filters" role="group" aria-label={lang === 'ar' ? 'تصفية المشاريع' : 'Filter projects'} data-filters>
        {cats.map((c, i) => (
          <button type="button" class="filter" data-filter={c} aria-pressed={i === 0 ? 'true' : 'false'}>
            {s.filters[c]}
          </button>
        ))}
      </div>
      {MAP_ENABLED && mapProjects.length > 0 && (
        <div class="views" role="group" aria-label={lang === 'ar' ? 'طريقة العرض' : 'View'} data-views>
          <button type="button" class="view" data-view="list" aria-pressed="true">{t(lang).map.grid}</button>
          <button type="button" class="view" data-view="map" aria-pressed="false">{t(lang).map.map}</button>
        </div>
      )}
    </div>
  </div>
</section>

<section class="pj-list" aria-label={s.title}>
  <div class="wrap">
    {MAP_ENABLED && <ProjectsMap lang={lang} />}
    <div class="pj-grid" data-grid>
      {projects.map((p, i) => (
        <div class="pj-item" data-item data-category={p.category} style={`--vtn: pj-${p.slug}`}>
          <ProjectCard lang={lang} project={p} i={i} size="md" eager={i < 2} />
        </div>
      ))}
    </div>
    <p class="empty" data-empty hidden>{s.empty}</p>
  </div>
</section>

<ProjectOverlay lang={lang} />

<script>
  import '../scripts/projects';
  import '../scripts/filter';
  import '../scripts/map';
</script>

<style>
  .pj-head { padding-block: calc(var(--header-h) + var(--sp-6)) var(--sp-5); }
  .pj-title { font-size: var(--step-3); letter-spacing: var(--track-display); line-height: var(--lead-display); }
  :global(html[lang='ar']) .pj-title { font-weight: 600; }
  .pj-lede { margin-block-start: var(--sp-2); color: var(--ink-2); max-inline-size: 52ch; font-size: var(--step-1); line-height: 1.6; }

  /* Filters: plain text tabs on a rule, the active one underlined in red */
  .pj-bar { margin-block-start: var(--sp-5); display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: var(--sp-2) var(--sp-4); border-block-end: 1px solid var(--line); }
  .filters { display: flex; flex-wrap: wrap; gap: 0 var(--sp-4); }
  /* List / Map: a small two-part switch */
  .views { display: inline-flex; margin-block-end: var(--sp-1); box-shadow: inset 0 0 0 1px var(--line-strong); border-radius: 2px; }
  .view { min-block-size: var(--tap); padding-inline: var(--sp-2); color: var(--ink-2); font-size: var(--step--1); letter-spacing: var(--track-small); line-height: var(--lead-small); transition: background-color 200ms ease, color 200ms ease; }
  :global(html[lang='ar']) .view { font-size: var(--step-0); }
  .view[aria-pressed='true'] { background: var(--ink); color: var(--bg); }
  @media (hover: hover) and (pointer: fine) { .view[aria-pressed='false']:hover { color: var(--ink); } }
  .filter {
    position: relative; min-block-size: var(--tap); min-inline-size: var(--tap); padding-block: var(--sp-1);
    color: var(--ink-2); font-size: var(--step-0);
    transition: color 200ms ease;
  }
  .filter::after {
    content: ''; position: absolute; inset-inline: 0; inset-block-end: -1px; block-size: 2px;
    background: var(--red); transform: scaleX(0); transition: transform 220ms var(--ease-out);
  }
  .filter[aria-pressed='true'] { color: var(--ink); }
  .filter:active, .view:active { opacity: 0.55; }
  .filter[aria-pressed='true']::after { transform: scaleX(1); }
  @media (hover: hover) and (pointer: fine) { .filter[aria-pressed='false']:hover { color: var(--ink); } }
  @media (prefers-reduced-motion: reduce) { .filter::after { transition: none; } }

  .pj-list { padding-block-end: var(--section); }
  .pj-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--sp-5) var(--sp-3); }
  @media (max-width: 960px) { .pj-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .pj-grid { grid-template-columns: 1fr; } }
  .pj-item[hidden], .pj-grid[hidden] { display: none; }
  /* Cards get transition names only while a filter change is animating */
  :global(html.vt-filter) .pj-item { view-transition-name: var(--vtn); }
  .empty { color: var(--ink-3); padding-block: var(--sp-6); }
</style>

<style is:global>
  /* Filter reflow animation (same-document View Transition) */
  ::view-transition-group(*) { animation-duration: 560ms; animation-timing-function: cubic-bezier(0.77, 0, 0.175, 1); }
  ::view-transition-new(*):only-child { animation: 420ms cubic-bezier(0.23, 1, 0.32, 1) both pj-enter; }
  ::view-transition-old(*):only-child { animation: 200ms ease both pj-exit; }
  @keyframes pj-enter { from { opacity: 0; transform: scale(0.96); } }
  @keyframes pj-exit { to { opacity: 0; transform: scale(0.97); } }
  @media (prefers-reduced-motion: reduce) {
    ::view-transition-group(*), ::view-transition-new(*), ::view-transition-old(*) { animation-duration: 0.01ms !important; }
  }
</style>
