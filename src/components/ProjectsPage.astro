---
import { t, type Lang } from '../i18n/strings';
import { projects, type Category } from '../data/projects';
import ProjectCard from './ProjectCard.astro';
import ProjectOverlay from './ProjectOverlay.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang).projects;
const used = new Set(projects.map((p) => p.category));
const cats: ('all' | Category)[] = ['all', ...(['hospitality', 'residential', 'commercial', 'mixed'] as Category[]).filter((c) => used.has(c))];
const counts = Object.fromEntries(cats.map((c) => [c, c === 'all' ? projects.length : projects.filter((p) => p.category === c).length]));
---
<section class="pj-head">
  <div class="wrap">
    <h1 class="pj-title"><span class="line"><span>{s.title}</span></span></h1>
    <div class="pj-bar">
      <p class="pj-lede">{s.lede}</p>
      <div class="filters" role="group" aria-label={lang === 'ar' ? 'تصفية المشاريع' : 'Filter projects'} data-filters>
        {cats.map((c, i) => (
          <button type="button" class="filter" data-filter={c} aria-pressed={i === 0 ? 'true' : 'false'}>
            {s.filters[c]}<sup>{counts[c]}</sup>
          </button>
        ))}
      </div>
    </div>
  </div>
</section>

<section class="pj-list" aria-label={s.title}>
  <div class="wrap">
    <div class="pj-grid" data-grid>
      {projects.map((p, i) => (
        <div class="pj-item" data-item data-category={p.category} style={`view-transition-name: pj-${p.slug}`}>
          <ProjectCard lang={lang} project={p} i={i} size="md" eager={i < 2} />
        </div>
      ))}
    </div>
    <p class="empty" data-empty hidden>{s.empty}</p>
  </div>
</section>

<ProjectOverlay lang={lang} />

<script>
  import '../scripts/projects';
  import '../scripts/filter';
</script>

<style>
  .pj-head { padding-block: calc(var(--header-h) + clamp(3rem, 8vw, 7rem)) clamp(2.5rem, 5vw, 4rem); }
  .pj-title { font-size: clamp(3.5rem, 2rem + 8vw, 9rem); letter-spacing: -0.045em; line-height: 0.95; }
  :global(html[lang='ar']) .pj-title { letter-spacing: 0; line-height: 1.2; font-weight: 600; }
  .line { display: block; overflow: clip; }
  .line > span { display: inline-block; animation: line-in 1000ms var(--ease-out) 120ms both; }
  @keyframes line-in { from { transform: translateY(105%); } to { transform: none; } }
  .pj-bar { margin-block-start: 2.5rem; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 1.5rem 2rem; }
  .pj-lede { color: var(--ink-2); max-inline-size: 36ch; font-size: var(--step-1); line-height: 1.5; animation: fade-up 800ms var(--ease-out) 350ms both; }
  @keyframes fade-up { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }

  .filters { display: flex; flex-wrap: wrap; gap: 0.5rem; animation: fade-up 800ms var(--ease-out) 450ms both; }
  .filter {
    display: inline-flex; align-items: center; gap: 0.35rem;
    min-block-size: 2.75rem; padding-inline: 1.1rem; border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--line-strong); color: var(--ink-2);
    font-size: var(--step--1);
    transition: background-color 220ms ease, color 220ms ease, box-shadow 220ms ease, transform var(--dur-press) var(--ease-out);
  }
  :global(html[lang='ar']) .filter { font-size: 0.95rem; }
  .filter sup { font-family: var(--font-en); font-size: 0.7em; color: var(--ink-3); transition: color 220ms ease; }
  .filter:active { transform: scale(0.97); }
  .filter[aria-pressed='true'] { background: var(--ink); color: var(--bg); box-shadow: none; }
  .filter[aria-pressed='true'] sup { color: var(--red); }
  @media (hover: hover) and (pointer: fine) {
    .filter[aria-pressed='false']:hover { color: var(--ink); box-shadow: inset 0 0 0 1px var(--ink-2); }
  }

  .pj-list { padding-block-end: var(--section); }
  .pj-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(3rem, 5vw, 5rem) clamp(1rem, 2.5vw, 2.5rem); }
  .pj-item:nth-child(even) { margin-block-start: clamp(0rem, 8vw, 8rem); }
  .pj-item[hidden] { display: none; }
  .pj-grid.is-filtered .pj-item { margin-block-start: 0; }
  @media (max-width: 700px) {
    .pj-grid { grid-template-columns: 1fr; }
    .pj-item:nth-child(even) { margin-block-start: 0; }
  }
  .empty { color: var(--ink-3); padding-block: 4rem; }

  @media (prefers-reduced-motion: reduce) {
    .line > span, .pj-lede, .filters { animation: none; }
  }
</style>

<style is:global>
  /* Filter reflow animation (same-document View Transition) */
  ::view-transition-group(*) { animation-duration: 560ms; animation-timing-function: cubic-bezier(0.77, 0, 0.175, 1); }
  ::view-transition-new(*):only-child { animation: 420ms cubic-bezier(0.23, 1, 0.32, 1) both pj-enter; }
  ::view-transition-old(*):only-child { animation: 200ms ease both pj-exit; }
  @keyframes pj-enter { from { opacity: 0; transform: scale(0.96); } }
  @keyframes pj-exit { to { opacity: 0; transform: scale(0.97); } }
  @media (prefers-reduced-motion: reduce) {
    ::view-transition-group(*), ::view-transition-new(*), ::view-transition-old(*) { animation-duration: 0.01ms !important; }
  }
</style>
