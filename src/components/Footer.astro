---
import { t, contact, type Lang } from '../i18n/strings';
import Wordmark from './Wordmark.astro';
import { company } from '../data/projects';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap">
    <div class="top">
      <Wordmark lang={lang} size="lg" />
      <div class="cols">
        <div class="col">
          <a href={`mailto:${contact.email}`} class="link-line" dir="ltr">{contact.email}</a>
          <a href={`tel:${contact.phoneTel}`} class="link-line" dir="ltr">{contact.phoneDisplay}</a>
          <a href={contact.whatsapp} class="link-line" target="_blank" rel="noopener">{s.inquiry.whatsapp}</a>
        </div>
        <div class="col">
          <a href={`/${lang}/projects/`} class="link-line">{s.nav.work}</a>
          <a href={`/${lang}/about/`} class="link-line">{s.nav.practice}</a>
          <button type="button" class="link-line as-link" data-inquire>{s.nav.inquire}</button>
        </div>
      </div>
    </div>
    <div class="bottom">
      <span>© {year} {s.firm}. {s.footer.rights}.</span>
      <span>{company.address[lang] ?? s.footer.city}</span>
    </div>
    {(company.crNumber || company.vatNumber || company.sceNumber) && (
      <p class="legal">
        {company.crNumber && <span>{s.footer.cr} <bdi dir="ltr">{company.crNumber}</bdi></span>}
        {company.vatNumber && <span>{s.footer.vat} <bdi dir="ltr">{company.vatNumber}</bdi></span>}
        {company.sceNumber && <span>{s.footer.sce} <bdi dir="ltr">{company.sceNumber}</bdi></span>}
      </p>
    )}
  </div>
</footer>

<style>
  .site-footer { border-block-start: 1px solid var(--line); padding-block: var(--sp-6) calc(var(--sp-4) + env(safe-area-inset-bottom, 0px)); background: var(--bg-sunken); }
  .top { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--sp-5); }
  .cols { display: flex; gap: var(--sp-6); flex-wrap: wrap; }
  .col { display: grid; gap: var(--sp-1); align-content: start; justify-items: start; color: var(--ink-2); }
  .as-link { text-align: start; color: inherit; }
  @media (pointer: coarse) { .col { gap: 0; } }
  .bottom { margin-block-start: var(--sp-6); display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--sp-1) var(--sp-4); color: var(--ink-3); font-size: var(--step--1); letter-spacing: var(--track-small); line-height: var(--lead-small); }
  :global(html[lang='ar']) .bottom { font-size: 0.9rem; }
  .legal { margin-block-start: var(--sp-2); display: flex; flex-wrap: wrap; gap: var(--sp-1) var(--sp-4); color: var(--ink-3); font-size: var(--step--1); letter-spacing: var(--track-small); line-height: var(--lead-small); }
  :global(html[lang='ar']) .legal { font-size: 0.9rem; }
</style>
