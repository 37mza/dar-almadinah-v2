---
import { t, contact, type Lang } from '../i18n/strings';
import Wordmark from './Wordmark.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap">
    <div class="top">
      <Wordmark lang={lang} size="lg" />
      <div class="cols">
        <div class="col">
          <a href={`mailto:${contact.email}`} class="link-line" dir="ltr">{contact.email}</a>
          <a href={`tel:${contact.phoneTel}`} class="link-line" dir="ltr">{contact.phoneDisplay}</a>
          <a href={contact.whatsapp} class="link-line" target="_blank" rel="noopener">{s.inquiry.whatsapp}</a>
        </div>
        <div class="col">
          <a href={`/${lang}/projects/`} class="link-line">{s.nav.work}</a>
          <a href={`/${lang}/#practice`} class="link-line">{s.nav.practice}</a>
          <button type="button" class="link-line as-link" data-inquire>{s.nav.inquire}</button>
        </div>
      </div>
    </div>
    <div class="bottom">
      <span>© {year} {s.firm}. {s.footer.rights}.</span>
      <span>{s.footer.city}</span>
    </div>
  </div>
</footer>

<style>
  .site-footer { border-block-start: 1px solid var(--line); padding-block: clamp(3rem, 2rem + 4vw, 5.5rem) calc(2rem + env(safe-area-inset-bottom, 0px)); background: var(--bg-sunken); }
  .top { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 2.5rem; }
  .cols { display: flex; gap: clamp(2.5rem, 2rem + 4vw, 6rem); flex-wrap: wrap; }
  .col { display: grid; gap: 0.6rem; align-content: start; justify-items: start; color: var(--ink-2); }
  .as-link { text-align: start; color: inherit; }
  .bottom { margin-block-start: clamp(3rem, 2rem + 4vw, 5rem); display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem 2rem; color: var(--ink-3); font-size: var(--step--1); }
  :global(html[lang='ar']) .bottom { font-size: 0.9rem; }
</style>
