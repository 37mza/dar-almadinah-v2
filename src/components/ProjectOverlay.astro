---
import { t, type Lang } from '../i18n/strings';
import { projects } from '../data/projects';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang).projects;
const data = Object.fromEntries(
  projects.map((p) => [p.slug, {
    images: p.images,
    category: s.filters[p.category],
    year: p.year,
    area: p.areaSqm ? `${p.areaSqm.toLocaleString('en-US')} ${s.sqm}` : undefined,
    placeholder: !!p.placeholder,
    ...p[lang],
  }]),
);
---
<dialog class="po" data-project-overlay aria-labelledby="po-name">
  <div class="po-stage" data-po-stage>
    <div class="po-hero" data-po-hero>
      <img data-po-cover alt="" />
    </div>
    <button type="button" class="po-close" data-po-close aria-label={s.close}>
      <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
    </button>
    <div class="po-body" data-po-body>
      <div class="wrap po-grid">
        <div class="po-head">
          <p class="kicker" data-po-cat></p>
          <h2 id="po-name" data-po-name></h2>
          <p class="po-summary" data-po-summary></p>
          <button type="button" class="btn" data-po-inquire>
            {s.inquireSimilar}
            <svg class="arrow" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13m-5-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
        <dl class="po-facts" data-po-facts>
          <div data-fact="location"><dt>{s.location}</dt><dd></dd></div>
          <div data-fact="year"><dt>{s.year}</dt><dd></dd></div>
          <div data-fact="area"><dt>{s.area}</dt><dd></dd></div>
          <div data-fact="status"><dt>{s.status}</dt><dd></dd></div>
        </dl>
      </div>
      <div class="po-gallery" data-po-gallery></div>
    </div>
  </div>
  <script type="application/json" data-po-data set:html={JSON.stringify(data)} />
</dialog>

<style>
  .po {
    position: fixed; inset: 0; margin: 0;
    inline-size: 100vw; block-size: 100dvh; max-inline-size: none; max-block-size: none;
    padding: 0; border: 0; background: transparent; color: var(--ink);
    overflow: hidden;
  }
  .po::backdrop { background: transparent; }
  .po-stage {
    position: absolute; inset: 0;
    background: var(--bg);
    overflow-y: auto; overscroll-behavior: contain;
    will-change: clip-path;
  }
  .po-hero { position: relative; block-size: min(78svh, 900px); overflow: hidden; }
  .po-hero img { inline-size: 100%; block-size: 100%; object-fit: cover; transform-origin: 50% 50%; }
  .po-hero::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, var(--bg) 0%, transparent 40%); }
  .po-close {
    position: fixed; z-index: 2;
    inset-block-start: calc(1rem + env(safe-area-inset-top, 0px));
    inset-inline-end: var(--gutter);
    inline-size: 3rem; block-size: 3rem; display: grid; place-items: center;
    border-radius: 999px; background: rgba(10,10,11,0.55); color: var(--ink);
    -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
    box-shadow: inset 0 0 0 1px var(--line-strong);
    transition: transform var(--dur-press) var(--ease-out), opacity 200ms ease;
  }
  .po-close:active { transform: scale(0.94); }
  .po-body { position: relative; margin-block-start: -6rem; padding-block-end: calc(4rem + env(safe-area-inset-bottom, 0px)); }
  .po-grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: 3rem clamp(2rem, 5vw, 6rem); align-items: end; }
  @media (max-width: 860px) { .po-grid { grid-template-columns: 1fr; } }
  .po-head { display: grid; gap: 1.25rem; justify-items: start; }
  .po-head h2 { font-size: var(--step-3); }
  .po-summary { color: var(--ink-2); font-size: var(--step-1); line-height: 1.55; max-inline-size: 40ch; }
  .po-facts { margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem 2rem; border-block-start: 1px solid var(--line); padding-block-start: 1.5rem; }
  .po-facts dt { color: var(--ink-3); font-size: var(--step--1); }
  :global(html[lang='ar']) .po-facts dt { font-size: 0.95rem; }
  .po-facts dd { margin: 0.25rem 0 0; }
  .po-facts [hidden] { display: none; }
  .po-gallery {
    margin-block-start: clamp(3rem, 6vw, 5rem);
    display: grid; grid-auto-flow: column; grid-auto-columns: min(82vw, 1100px);
    gap: 1rem; overflow-x: auto; scroll-snap-type: x mandatory;
    padding-inline: var(--gutter); scroll-padding-inline: var(--gutter);
    overscroll-behavior-x: contain; scrollbar-width: none;
  }
  .po-gallery::-webkit-scrollbar { display: none; }
  .po-gallery img { inline-size: 100%; aspect-ratio: 16 / 10; object-fit: cover; scroll-snap-align: start; border-radius: 2px; background: var(--bg-raised); }

  /* Content enters after the image has expanded */
  :global(html.js) .po [data-po-in] { opacity: 0; transform: translateY(18px); }
  :global(html.js) .po.is-ready [data-po-in] {
    opacity: 1; transform: none;
    transition: opacity 600ms var(--ease-out), transform 700ms var(--ease-out);
    transition-delay: calc(var(--d, 0) * 60ms);
  }
  :global(html.js) .po.is-leaving [data-po-in] { opacity: 0; transition: opacity 120ms ease; transition-delay: 0ms; }
  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .po [data-po-in] { transform: none; }
  }
</style>
