---
import '@fontsource/ibm-plex-sans-arabic/400.css';
import '@fontsource/ibm-plex-sans-arabic/500.css';
import '@fontsource/ibm-plex-sans-arabic/600.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import InquiryPanel from '../components/InquiryPanel.astro';
import { t, type Lang } from '../i18n/strings';
import { organizationJsonLd, mdPath } from '../lib/agent';
import { ogImage } from '../data/projects';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  page: '' | 'projects' | 'about' | 'contact' | 'privacy';
}
const { lang, title, description, page } = Astro.props;
const s = t(lang);
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const ogImageUrl = ogImage ? site + ogImage.src : undefined;
const jsonLd = JSON.stringify(organizationJsonLd(site, lang, page, ogImageUrl)).replace(/</g, '\\u003c');
const pathFor = (l: Lang) => `/${l}/${page ? page + '/' : ''}`;
---
<!doctype html>
<html lang={lang} dir={s.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content" />
    <meta name="theme-color" content="#0a0a0b" media="(prefers-color-scheme: dark)" data-theme-color />
    <meta name="theme-color" content="#f4f2ee" media="(prefers-color-scheme: light)" data-theme-color />
    <meta name="color-scheme" content="dark light" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={site + pathFor(lang)} />
    <link rel="alternate" hreflang="ar" href={site + pathFor('ar')} />
    <link rel="alternate" hreflang="en" href={site + pathFor('en')} />
    <link rel="alternate" hreflang="x-default" href={site + pathFor('ar')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={site + pathFor(lang)} />
    <meta property="og:site_name" content={s.firm} />
    {ogImage && <meta property="og:image" content={ogImageUrl} />}
    {ogImage && <meta property="og:image:width" content={String(ogImage.width)} />}
    {ogImage && <meta property="og:image:height" content={String(ogImage.height)} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <link rel="alternate" type="text/markdown" href={site + mdPath(lang, page)} title="Markdown" />
    <script type="application/ld+json" set:html={jsonLd} />
    <meta property="og:locale" content={lang === 'ar' ? 'ar_SA' : 'en_US'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Blocking on purpose: sets the color scheme before first paint (no flash). External so the CSP needs no inline exceptions. -->
    <script is:inline src="/theme-init.js"></script>
  </head>
  <body>
    <a class="skip" href="#main">{lang === 'ar' ? 'انتقل إلى المحتوى' : 'Skip to content'}</a>
    <Header lang={lang} page={page} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <InquiryPanel lang={lang} />
    <script>
      import '../scripts/inquiry';
      import '../scripts/theme';
    </script>
  </body>
</html>
